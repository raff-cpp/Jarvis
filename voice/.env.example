# Copia questo file in ".env" (stessa cartella) e inserisci la tua chiave.
# Il file .env NON viene mai committato (vedi .gitignore) e NON viene mai
# esposto al browser: la chiave resta solo nel processo Python del server.

# Chiave di Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Modello (opzionale). Default: gemini-2.5-flash
# "flash" e il piu adatto a un assistente vocale: risponde in fretta.
# Per ragionamenti piu complessi: gemini-2.5-pro
# Per vedere i modelli disponibili sulla tua chiave:  python modelli.py
JARVIS_MODEL=gemini-2.5-flash

# Ricerca web di Google: auto | on | off
# "auto" la attiva e la disattiva da sola se il modello non la supporta
# insieme al controllo del PC.
JARVIS_WEB_SEARCH=auto

# Budget di ragionamento in token (opzionale).
# Vuoto = default del modello. 0 = ragionamento disattivato, risposte piu rapide.
JARVIS_THINKING_BUDGET=

# --- Voce ---
# Voce neurale usata dal server (molto migliore di quelle del browser):
#   diego     maschile, autorevole  (predefinita, da maggiordomo)
#   giuseppe  maschile, piu morbido
#   elsa / isabella  femminili
JARVIS_VOICE=diego
# Cadenza: negativo = piu lento e piu grave (tono da maggiordomo).
JARVIS_VOICE_RATE=-8%
JARVIS_VOICE_PITCH=-12Hz

# Porta del server locale (opzionale). Default: 8730
JARVIS_PORT=8730
