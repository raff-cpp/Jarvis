# Copia questo file in ".env" (stessa cartella) e inserisci la tua chiave.
# Il file .env NON viene mai committato (vedi .gitignore) e NON viene mai
# esposto al browser: la chiave resta solo nel processo Python del server.

# Chiave di Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Modello (opzionale). Default: gemini-2.5-flash
# "flash" e il piu adatto a un assistente vocale: risponde in fretta.
# Per ragionamenti piu complessi: gemini-2.5-pro
# Per vedere i modelli disponibili sulla tua chiave:  python modelli.py
JARVIS_MODEL=gemini-2.5-flash

# Ricerca web di Google (grounding): auto | on | off
# Sulle chiavi gratuite ha quota ZERO, quindi "off" e la scelta giusta:
# Jarvis usa comunque i suoi strumenti web_search / weather / fetch_page,
# che non richiedono chiave ne quota.
JARVIS_WEB_SEARCH=off

# Comandi diretti: on | off
# "alza il volume", "che ore sono", "apri firefox" e simili vengono eseguiti
# subito in locale, senza chiamare il modello: risposta istantanea e nessuna
# richiesta consumata. Metti "off" per far passare tutto dall'AI.
JARVIS_FAST_INTENTS=on

# Budget di ragionamento in token (opzionale).
# Vuoto = default del modello. 0 = ragionamento disattivato, risposte piu rapide.
JARVIS_THINKING_BUDGET=

# --- Voce ---
# Voce neurale usata dal server (molto migliore di quelle del browser):
#   diego     maschile, autorevole  (predefinita, da maggiordomo)
#   giuseppe  maschile, piu morbido
#   elsa / isabella  femminili
JARVIS_VOICE=diego
# Cadenza: negativo = piu lento e piu grave (tono da maggiordomo).
JARVIS_VOICE_RATE=-8%
JARVIS_VOICE_PITCH=-12Hz

# --- Iniziativa di Jarvis ---
# Jarvis parla per primo: download completati, batteria scarica, promemoria.
# Le condizioni sono locali e le frasi sono fisse: nessun consumo di quota.
JARVIS_PROATTIVO=on

# Riepilogo della giornata al primo avvio di ogni giorno (meteo, promemoria,
# to-do, spazio disco). Puoi chiederlo anche a voce dicendo "buongiorno".
JARVIS_BRIEFING_AUTO=on

# Citta per il meteo del briefing. Vuoto = rilevata dalla connessione.
JARVIS_CITTA=

# Scorciatoia globale: richiama Jarvis da qualunque applicazione.
# Modificatori: ctrl, alt, shift, win. Tasti: lettere, cifre, f1-f12, space.
# Se un altro programma la usa gia, Jarvis lo segnala all'avvio e prosegue.
JARVIS_HOTKEY=ctrl+alt+j

# Porta del server locale (opzionale). Default: 8730
JARVIS_PORT=8730
